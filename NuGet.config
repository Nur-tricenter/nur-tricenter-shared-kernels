<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    NuGet feeds for building and publishing the platform kernels.

    The organization feed is where these four packages are published and where every service
    restores them from. That is what replaces the old relative-path ProjectReference: a service
    declares a PackageReference and gets the kernel from here, so no repository needs to know
    where any other one lives on disk.

    AUTHENTICATION

    GitHub Packages expects a classic personal access token. It needs the read:packages scope to
    restore and write:packages to push. Never put the token in this file.

    Register the feed once, from a shell, replacing the two placeholders:

      dotnet nuget add source https://nuget.pkg.github.com/Nur-tricenter/index.json
        [name] Nur-tricenter
        [username] YOUR_GITHUB_USER
        [password] YOUR_TOKEN

    Or set the two environment variables below on the machine, and the credentials block at the
    bottom of this file picks them up automatically:

      setx NUGET_USERNAME YOUR_GITHUB_USER
      setx NUGET_TOKEN YOUR_TOKEN
  -->

  <packageSources>
    <clear />

    <!-- Official feed: still needed for every third-party package. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- The organization: where Nur.Tricenter.* is published. -->
    <add key="Nur-tricenter" value="https://nuget.pkg.github.com/Nur-tricenter/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping: which feed NuGet searches for which package. Without it, two configured
    sources plus Central Package Management raise NU1507 and NuGet has to guess.

    ONLY the platform kernels are mapped to the organization feed. The Joseco.* libraries are
    deliberately NOT: they are public packages on nuget.org. Mapping them here makes restore fail
    with NU1101, because mapping is EXCLUSIVE â€” once a pattern names a feed, NuGet will not look
    anywhere else for it. That mistake shipped here once and only surfaced in a Docker build,
    where the global package cache was empty.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Nur-tricenter">
      <package pattern="Nur.Tricenter.*" />
    </packageSource>
  </packageSourceMapping>
  
  <packageSourceCredentials>
    <Nur-tricenter>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </Nur-tricenter>
  </packageSourceCredentials>

</configuration>